# ============================================================
# 必須: OpenAI
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MARKET_REASONING_EFFORT=medium
OPENAI_MANAGEMENT_REASONING_EFFORT=medium
# true: 複数銘柄を一括分析 / false: 1銘柄ずつ分析
OPENAI_BATCH_ANALYSIS=true
# 一括分析1リクエストあたりの最大銘柄数
OPENAI_BATCH_MAX_SYMBOLS=6

# ============================================================
# 実運用では必須: GMO FX Private API（参照権限のみ）
# ============================================================
GMO_FX_API_KEY=
GMO_FX_API_SECRET=

# ============================================================
# Discord
# ============================================================
DISCORD_FOREX_MAIN=
DISCORD_FOREX_OTHER=
# 任意。未設定なら重要指標通知はMAINへ送る
DISCORD_FOREX_EVENT=

# ============================================================
# リスク管理
# 初期値は仮置き。履歴DBを見て検証・調整すること。
# ============================================================
BASE_CAPITAL_JPY=400000
TARGET_ANNUAL_RETURN_PCT=100
RISK_PER_TRADE_PCT=0.75
MAX_TOTAL_RISK_PCT=2.5
MIN_MARGIN_RATIO=150
MIN_RR=1.5
MAX_CURRENCY_EXPOSURE_RISK=2.0
MAX_SPREAD_ATR_RATIO=0.12
ENTRY_SCORE_THRESHOLD=0.65
ENTRY_QUALITY_THRESHOLD=0.68

# ============================================================
# 無料の経済指標カレンダー（API Key不要）
# ============================================================
FOREX_FACTORY_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
EVENT_PRE_MINUTES=60
EVENT_IMMINENT_MINUTES=30
EVENT_POST_MINUTES=30
EVENT_RELEASE_LOOKBACK_MINUTES=45
EVENT_FAIL_SAFE=true
CALENDAR_CACHE_MAX_AGE_HOURS=36

# ============================================================
# 市場データ
# ============================================================
MAX_TICKER_AGE_SECONDS=180
OHLC_TARGET_BARS=320
OHLC_MAX_YEARS=5
OHLC_MAX_DAYS=45

# ============================================================
# GMO約定履歴同期
# ============================================================
SYNC_EXECUTIONS=true
EXECUTION_SYNC_INTERVAL_HOURS=6

# ============================================================
# 永続状態
# cron環境ではデプロイ等で消えないパスを推奨
# ============================================================
BOT_STATE_DIR=state
BOT_STATE_DB=state/fxbot.sqlite3
CALENDAR_CACHE_PATH=state/ff_calendar_cache.json

# ============================================================
# 安全設定・通知
# ============================================================
PRIVATE_API_FAIL_SAFE=true
SIGNAL_DEDUP_MINUTES=180
VIRTUAL_SIGNAL_PENDING_HOURS=12

# 最新市場材料（公開RSS、追加API Key不要）
NEWS_MAX_AGE_HOURS=24
NEWS_CACHE_MAX_AGE_MINUTES=30
NEWS_MAX_ITEMS_PER_SYMBOL=5
